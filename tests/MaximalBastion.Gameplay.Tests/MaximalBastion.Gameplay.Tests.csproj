<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MaximalBastion.Gameplay/MaximalBastion.Gameplay.csproj" />
    <ProjectReference Include="../../src/MaximalBastion/MaximalBastion.csproj" Aliases="legacy" Condition="'$(LegacyAssemblyPath)' == ''" />
    <Reference Include="MaximalBastion" HintPath="$(LegacyAssemblyPath)" Aliases="legacy" Condition="'$(LegacyAssemblyPath)' != ''" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" />
    <None Include="../../src/MaximalBastion/ContentData/**/*.json" Link="ContentData/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
