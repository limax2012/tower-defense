#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)/Content
/intermediateDir:obj/$(Platform)/Content
/platform:BlazorGL
/config:
/quiet

#---------------------------------- Content ---------------------------------#

#begin Fonts/Interface.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/build:Fonts/Interface.spritefont

#begin ../../MinimalBastion/Content/Audio/MainMenuLoop.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/processorParam:Quality=Best
/build:../../MinimalBastion/Content/Audio/MainMenuLoop.wav;Audio/MainMenuLoop.wav

#begin ../../MinimalBastion/Content/Audio/Music/BassyRollIn.ogg
/importer:OggImporter
/processor:SongProcessor
/build:../../MinimalBastion/Content/Audio/Music/BassyRollIn.ogg;Audio/Music/BassyRollIn.ogg

#begin ../../MinimalBastion/Content/Audio/Music/ChillStroll.ogg
