      </CharacterRegion>
      <CharacterRegion>
        <Start>&#8226;</Start>
        <End>&#8226;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#176;</Start>
        <End>&#176;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
